# Runtime configuration is parsed strictly as data by scripts/runtime_config.py.
# Do not use shell quoting, expansion, or inline comments.
# This fixed name scopes all Compose resources and must not be changed.
COMPOSE_PROJECT_NAME=woow_headscale

# Public Headscale URL. Keep this static value for direct access, or override it
# with the URL returned by the ngrok-url subcommand when ngrok is enabled.
SERVER_URL=http://localhost:28080
LOG_LEVEL=info
IPV4_PREFIX=100.64.0.0/10
IPV6_PREFIX=fd7a:115c:a1e0::/48
# Must not equal, or be a parent domain of, the SERVER_URL hostname.
MAGIC_DNS_BASE_DOMAIN=ts.local
CREATE_DEFAULT_USER=true

# Ngrok is opt-in. Never commit a populated NGROK_AUTHTOKEN.
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_MODE=http
# Optional fixed/reserved domain, without a URL scheme.
NGROK_DOMAIN=

# Container bind addresses and internal service ports.
HEADSCALE_BIND_ADDR=0.0.0.0
HEADSCALE_PORT=8080
HEADSCALE_METRICS_BIND_ADDR=0.0.0.0
HEADSCALE_METRICS_PORT=9090
HEADPLANE_BIND_ADDR=0.0.0.0
HEADPLANE_PORT=3000

# Published host bindings. Metrics and Headplane default to loopback only.
HEADSCALE_HOST_BIND_ADDR=0.0.0.0
HEADSCALE_HOST_PORT=28080
HEADSCALE_METRICS_HOST_BIND_ADDR=127.0.0.1
HEADSCALE_METRICS_HOST_PORT=29090
HEADPLANE_HOST_BIND_ADDR=127.0.0.1
HEADPLANE_HOST_PORT=23000
# Headplane serves HTTP internally by default; enable only if it terminates TLS itself.
HEADPLANE_COOKIE_SECURE=false
