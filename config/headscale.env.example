# ~/.config/headscale/headscale.env: the per-host settings of the Woow Headscale stack.
# scripts/install.sh creates this file from the example (mode 0600) and renders the Quadlet
# units and the two container configuration files from it. After editing, run
# scripts/install.sh again; nothing here is read at container runtime.
#
# Rules, because podman and the strict parser both read this file as data:
# KEY=VALUE, one line each, no quotes, no "export", and no "# comment" after a value.
#
# There are no credentials in this file, and install.sh refuses one. The two Headplane
# secrets are podman secrets: headscale-headplane-cookie (generated) and
# headscale-headplane-api-key (created with `headscale apikeys create`).

# Where the host publishes each port. Use 127.0.0.1 (the default, and what STANDARD asks
# for), an IPv4 address of this host, or "all" for every address.
WOOW_HEADSCALE_BIND=127.0.0.1
WOOW_HEADSCALE_PORT=28080
WOOW_HEADSCALE_METRICS_BIND=127.0.0.1
WOOW_HEADSCALE_METRICS_PORT=29090
WOOW_HEADPLANE_BIND=127.0.0.1
WOOW_HEADPLANE_PORT=23000

# The URL Tailscale clients dial. It must be the address they can actually reach - the
# reverse proxy or router port-forward in front of this host, not this container's port.
# A client that is given the wrong value registers and then never connects.
HEADSCALE_SERVER_URL=http://localhost:28080

# MagicDNS suffix for node names. It must NOT be equal to, or a parent of, the hostname in
# HEADSCALE_SERVER_URL: headscale refuses to start, because its own URL would resolve
# inside the tailnet.
HEADSCALE_BASE_DOMAIN=ts.local

# Address pools handed out to nodes.
HEADSCALE_IPV4_PREFIX=100.64.0.0/10
HEADSCALE_IPV6_PREFIX=fd7a:115c:a1e0::/48

# trace, debug, info, warn or error.
HEADSCALE_LOG_LEVEL=info

# Create the headscale user "default" on the first install, so a node can be enrolled
# straight away. true or false.
HEADSCALE_CREATE_DEFAULT_USER=true

# Set to true only when something in front of Headplane terminates TLS. Headplane speaks
# plain HTTP inside the container, so a secure cookie over a plain-HTTP hop never comes
# back and the admin UI cannot log in. true or false.
HEADPLANE_COOKIE_SECURE=false
