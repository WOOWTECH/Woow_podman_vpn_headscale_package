# Headplane 0.7.0: the admin UI for the Headscale control plane above. It is optional in the
# sense that stopping it does not disturb a single VPN node, and it is never the path a
# Tailscale client uses.
#
# It needs two secrets, and both are podman secrets rather than files in this repo:
#   headscale-headplane-cookie    32 random characters, generated by scripts/install.sh
#   headscale-headplane-api-key   a Headscale API key, created by scripts/install.sh with
#                                 `headscale apikeys create` once the control plane is up
# That ordering is why install.sh starts headscale first and headplane afterwards.
#
# There is no HealthCmd: we do not build this image and cannot promise a probe binary
# exists inside it, and a probe that is missing would leave the unit permanently unhealthy.
# Readiness is checked over HTTP by scripts/install.sh and tests/smoke.sh instead.
[Unit]
Description=Woow Headplane admin UI for Headscale
Documentation=https://github.com/WOOWTECH/Woow_podman_vpn_headscale_package
Documentation=https://github.com/tale/headplane
Requires=headscale.service
After=headscale.service

[Container]
ContainerName=headplane
Image=ghcr.io/tale/headplane:0.7.0@sha256:7bd6523a14567a43eb4ffa1e95e3d95456b8539c9d081757df3f228b9e836fb5
Network=headscale.network
HostName=headplane
PublishPort=@@HEADPLANE_PUBLISH@@:3000
Volume=headplane-data.volume:/var/lib/headplane
Volume=%h/.config/headscale/headplane/config.yaml:/etc/headplane/config.yaml:ro,Z
Secret=headscale-headplane-cookie,type=mount,target=/etc/headplane/cookie-secret,mode=0400
Secret=headscale-headplane-api-key,type=mount,target=/etc/headplane/api-key,mode=0400
NoNewPrivileges=true
Label=io.woowtech.app=headscale
PodmanArgs=--stop-timeout=30

[Service]
# Requires=/After= order the start but say nothing about readiness, and 4.9.3 ignores
# Notify=healthy. Wait for the control plane to answer before Headplane dials it. No shell
# variable appears in the command: systemd would expand $name itself.
ExecStartPre=/usr/bin/timeout 180 /bin/sh -c 'until /usr/bin/podman exec headscale /ko-app/headscale health >/dev/null 2>&1; do sleep 3; done'
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not trap
# it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
