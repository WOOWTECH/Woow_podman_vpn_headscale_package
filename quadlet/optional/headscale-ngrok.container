# Optional public control-plane endpoint. HTTP supports a reserved domain or
# the account's dev domain; TCP is for testing only (no TLS). Both modes dial
# the entrance's private :8081 path filter, never the admin UI or API.
[Unit]
Description=Woow Headscale ngrok control tunnel
Before=headscale.service

[Container]
ContainerName=headscale-ngrok
Image=docker.io/ngrok/ngrok:3.39.11-alpine@sha256:4147f33ead67712d642fde29af4a9e258d7a937ef97be146397b7e2a2e8e8dd1
Network=headscale.network
HostName=headscale-ngrok
Exec=@@HEADSCALE_NGROK_EXEC@@
Secret=headscale-ngrok-authtoken,type=env,target=NGROK_AUTHTOKEN
NoNewPrivileges=true
Label=io.woowtech.app=headscale
PodmanArgs=--stop-timeout=30

[Service]
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
