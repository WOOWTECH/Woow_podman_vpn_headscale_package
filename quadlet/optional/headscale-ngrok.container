# Optional public HTTPS control-plane endpoint. A reserved domain and a Podman
# authtoken secret are required; neither the admin UI nor the Headscale API is
# exposed through this tunnel (the entrance's private :8081 filters paths).
[Unit]
Description=Woow Headscale ngrok control tunnel
Requires=headscale-entrance.service
After=headscale-entrance.service

[Container]
ContainerName=headscale-ngrok
Image=docker.io/ngrok/ngrok:3.39.11-alpine@sha256:4147f33ead67712d642fde29af4a9e258d7a937ef97be146397b7e2a2e8e8dd1
Network=headscale.network
HostName=headscale-ngrok
Exec=http headscale-entrance:8081 --url @@HEADSCALE_NGROK_URL@@ --log stdout --inspect=false
Secret=headscale-ngrok-authtoken,type=env,target=NGROK_AUTHTOKEN
NoNewPrivileges=true
Label=io.woowtech.app=headscale
PodmanArgs=--stop-timeout=30

[Service]
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
